<linker>
  <!--
    Нативные callback-методы Cross-Promo (OnExoOverlayStarted/Cta/Closed/Error/Completed и
    OnExoPlayerPrepared/Completed/Error) вызываются ТОЛЬКО из Java через UnitySendMessage.
    В C# на них нет ни одной ссылки, поэтому managed code stripping (IL2CPP) при агрессивных
    настройках сборки игры может их выкинуть — и тогда ломается всё: клики, показы, закрытие
    рекламы. Сам класс оверлея тоже создаётся по строковому имени (AndroidJavaObject), поэтому
    сохраняем оба типа целиком. Дублирует атрибуты [UnityEngine.Scripting.Preserve] на методах.
  -->
  <!-- После разрезания на per-module asmdef типы Cross-Promo живут в сборке
       AMZNGoDSDK.Module.CrossPromo (раньше — AMZNGoD.Runtime). -->
  <assembly fullname="AMZNGoDSDK.Module.CrossPromo">
    <type fullname="AMZNGoDSDK.Runtime.CrossPromoExoNativeOverlay" preserve="all"/>
    <type fullname="AMZNGoDSDK.Runtime.CrossPromoVideoPlayer" preserve="all"/>
  </assembly>
</linker>
