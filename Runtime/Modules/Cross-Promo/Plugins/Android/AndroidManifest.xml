<?xml version="1.0" encoding="utf-8"?>
<!--
    QUERY_ALL_PACKAGES нужен CrossPromoModule.AppChecker для отсева
    промо-видео, чей target-пакет уже установлен на устройстве.
    С Android 11 (API 30) без этого разрешения PackageManager.getPackageInfo
    бросает NameNotFoundException для любого пакета, не объявленного в
    <queries>, — фильтр установленных приложений в этом случае молча
    выдаёт "не установлено" для всего подряд и промо продолжают крутиться.

    Разрешение мёржится Gradle в главный AndroidManifest донора.
    На Amazon Appstore / Fire OS проходит без обоснований.
    На Google Play при заливке потребуется декларация в форме
    "App content → Permissions" (обоснование — детектим установленные
    приложения для фильтрации собственной рекламы, чтоб не показывать
    промо того, что у пользователя уже есть).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
</manifest>
