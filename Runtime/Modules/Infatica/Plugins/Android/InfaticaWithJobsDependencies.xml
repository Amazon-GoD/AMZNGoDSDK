<?xml version="1.0" encoding="utf-8"?>
<!--
  EDM4U dependency for the Infatica *WithJobs* variant only.

  This file lives inside the WithJobs plugin set. When WithJobs is INACTIVE the
  whole folder is stored as Plugins_WithJobs~ (tilde) and Unity/EDM4U ignore it,
  so the WithoutJobs build never pulls WorkManager. When WithJobs is active the
  folder becomes Plugins/Android and EDM4U resolves androidx.work here.

  Do NOT move this into Infatica/Editor/InfaticaDependencies.xml — that file is
  shared by both variants and would force WorkManager onto WithoutJobs too.
-->
<dependencies>
    <androidPackages>
        <androidPackage spec="androidx.work:work-runtime:2.9.1">
        </androidPackage>
    </androidPackages>
</dependencies>
